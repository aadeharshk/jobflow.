{
  "name": "jobflow",
  "version": "0.1.0",
  "private": true,
  "description": "Global AI job intelligence & application automation platform, built entirely on Cloudflare.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:worker",
    "build:web": "vite build --config web/vite.config.ts",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker --env=\"\"",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:worker && npm run test:web",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "test:web": "vitest run --config web/vitest.config.ts",
    "test:e2e": "playwright test",
    "cf:types": "wrangler types worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB_CORE --local && wrangler d1 migrations apply DB_JOBS --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB_CORE --remote && wrangler d1 migrations apply DB_JOBS --remote",
    "deploy": "npm run build:web && wrangler deploy",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "e2e:server": "bash scripts/e2e-server.sh",
    "cf:setup": "bash scripts/setup-cloudflare.sh"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@tanstack/react-query": "5.107.1",
    "arctic": "3.7.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.0",
    "@cloudflare/workers-types": "5.20261110.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "prettier": "3.10.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.160.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261110.1": true
  }
}
